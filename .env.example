# Salin menjadi .env dan isi nilai rahasia sendiri. JANGAN commit .env.
NODE_ENV=development
PORT=5000

# Wajib pada production. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_min_32_characters_for_enterprise_security
JWT_EXPIRES_IN=8h

# Daftar origin frontend yang diizinkan (pisahkan koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
SIMULATED_LATENCY_MS=0

# ==============================================================================
# KONFIGURASI SUPABASE (POSTGRESQL & CLOUD STORAGE)
# ==============================================================================
# 1. Connection String PostgreSQL Supabase (Didapat dari Dashboard Supabase -> Project Settings -> Database)
# Gunakan port 6543 (PgBouncer/Supavisor Transaction Pooler) untuk Vercel Serverless:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# 2. Supabase API Credentials (Didapat dari Dashboard Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==============================================================================
# FALLBACK BASIS DATA LOKAL (JIKA DATABASE_URL TIDAK DIISI)
# ==============================================================================
DB_PATH=./server/simpro.sqlite
